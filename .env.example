# Copy this file to .env (it is git-ignored). Never commit real keys, never paste them in chat.

# Portfolio dashboard: a READ-ONLY key from your real Binance account.
# In Binance: Account > API Management > Create API > enable "Enable Reading" ONLY,
# leave trading / withdrawals / transfers OFF, and restrict the key to your IP address.
# The dashboard refuses to run if the key has withdrawals enabled.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional: free CoinGecko demo key (higher rate limit for trending / meme lists).
COINGECKO_API_KEY=

# Binance Spot DEMO trading only (separate keys, fake money). Never use live keys here.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
